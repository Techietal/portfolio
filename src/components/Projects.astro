---
/**
 * Work section (PLAN.md §5.3 row 5): two-column grid of ProjectCard; every
 * second card sits 28px lower, on desktop only.
 */
import { getProjects } from '../lib/site';
import ProjectCard from './ProjectCard.astro';

const projects = await getProjects();
---

<section class="section work" id="work">
  <div class="shell">
    <div class="section-head">
      <h2>Work that<br />works hard.</h2>
      <p>Agents, platforms and models — with numbers attached.</p>
    </div>

    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 24px;
    align-items: start;
  }

  @media (min-width: 801px) {
    .grid > :global(.pcard:nth-child(even)) {
      margin-top: 28px;
    }
  }

  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
