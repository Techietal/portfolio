---
/**
 * Contact (PLAN.md §5.3 row 10): full-width ink block, white text, heading
 * with the highlighted word coloured acid (no pink bar), a mailto button and
 * a mono row of phone / social / resume links.
 */
import { getProfile, parseHighlight } from '../lib/site';

const profile = await getProfile();
const contact = profile.contact;

/** "Email me ↗" → { text: 'Email me', glyph: '↗' } so the arrow can be aria-hidden. */
function splitTrailingGlyph(label: string): { text: string; glyph: string } {
  const match = /\s*([↗↓✹✦])\s*$/.exec(label);
  if (!match || !match[1]) return { text: label, glyph: '' };
  return { text: label.slice(0, match.index).trimEnd(), glyph: match[1] };
}

const button = splitTrailingGlyph('Email me ↗');
---

<section class="contact" id="contact">
  <div class="shell contact__inner">
    <h2 class="contact__heading">
      {
        parseHighlight(contact.heading).map((part) =>
          part.hl ? <span class="contact__hl">{part.text}</span> : part.text,
        )
      }
    </h2>

    <p class="contact__blurb">{contact.blurb}</p>

    <a class="contact__btn" href={`mailto:${contact.email}`}>
      {button.text}{button.glyph && <span aria-hidden="true"> {button.glyph}</span>}
    </a>

    <ul class="contact__links">
      <li>
        <a href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
      </li>
      {
        contact.links.map((link) => (
          <li>
            <a href={link.url} rel="noopener">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/silaparasetti-lohith-resume.pdf">Resume</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact {
    padding: 52px 0;
    background: var(--ink);
    color: var(--white);
  }

  .contact__inner {
    text-align: center;
  }

  .contact__heading {
    font-size: clamp(46px, 7vw, 92px);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }

  .contact__hl {
    color: var(--acid);
  }

  .contact__blurb {
    max-width: 560px;
    margin: 20px auto 0;
    color: var(--muted);
    font-size: 14px;
  }

  .contact__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 50px;
    margin-top: 26px;
    padding: 0 20px;
    border: 3px solid var(--white);
    background: var(--hot);
    color: var(--ink);
    box-shadow: 5px 5px 0 var(--white);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .contact__btn:hover {
    transform: translate(3px, 3px);
    box-shadow: 2px 2px 0 var(--white);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    margin: 26px 0 0;
    list-style: none;
  }

  .contact__links a {
    color: var(--white);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .contact__links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--acid);
  }

  @media (max-width: 580px) {
    .contact {
      padding: 40px 0;
    }
  }
</style>
