---
/**
 * Hero (PLAN.md §5.3 row 2): blue eyebrow tag, the page's single H1 built
 * from `hero.headlineLines` (words in [brackets] get the pink highlighter),
 * intro and two CTAs — plus the rotated blue poster card holding the photo,
 * with top mono labels, bottom caption, acid wiggle sticker and white note.
 */
import { Picture } from 'astro:assets';
import photo from '../assets/lohith.jpg';
import { getProfile, parseHighlight } from '../lib/site';

const profile = await getProfile();
const hero = profile.hero;

/** "See the work ↗" → { text: 'See the work', glyph: '↗' } so the arrow can be aria-hidden. */
function splitTrailingGlyph(label: string): { text: string; glyph: string } {
  const match = /\s*([↗↓✹✦])\s*$/.exec(label);
  if (!match || !match[1]) return { text: label, glyph: '' };
  return { text: label.slice(0, match.index).trimEnd(), glyph: match[1] };
}

/** "↑ Usually building agents" → { glyph: '↑', text: 'Usually building agents' } */
function splitLeadingGlyph(text: string): { glyph: string; text: string } {
  const match = /^\s*([↗↓✹✦↑])\s*/.exec(text);
  if (!match || !match[1]) return { glyph: '', text };
  return { glyph: match[1], text: text.slice(match[0].length) };
}

const primary = splitTrailingGlyph(hero.primaryCta.label);
const secondary = splitTrailingGlyph(hero.secondaryCta.label);
const note = splitLeadingGlyph(hero.note);
---

<section class="hero" id="top">
  <div class="shell hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="hero__title">
        <!-- Visible full name: the strongest on-page signal for searches on the name -->
        <span class="hero__name">{profile.name}</span>
        {
          hero.headlineLines.map((line, index) => (
            <>
              {index > 0 && <br />}
              {parseHighlight(line).map((part) =>
                part.hl ? <span class="hl">{part.text}</span> : part.text,
              )}
            </>
          ))
        }
      </h1>
      <p class="hero__intro">{hero.intro}</p>
      <div class="hero__actions">
        <a class="btn" href={hero.primaryCta.href}>
          {primary.text}{primary.glyph && <span aria-hidden="true"> {primary.glyph}</span>}
        </a>
        <a class="btn btn--alt" href={hero.secondaryCta.href} download>
          {secondary.text}{secondary.glyph && <span aria-hidden="true"> {secondary.glyph}</span>}
        </a>
      </div>
    </div>

    <div class="hero__poster-wrap">
      <div class="hero__sticker">{hero.sticker}</div>
      <div class="hero__poster bouncy">
        <div class="hero__poster-top">
          <span>{hero.posterTopLeft}</span>
          <span>{hero.posterTopRight}</span>
        </div>
        <div class="hero__poster-media">
          <Picture
            src={photo}
            formats={['avif', 'webp']}
            widths={[360, 540, 720]}
            sizes="(max-width: 800px) 92vw, 470px"
            alt="Silaparasetti Lohith smiling, standing outside an office building"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="hero__poster-bottom">{hero.posterBottom}</div>
      </div>
      <div class="hero__note">
        {note.glyph && <span aria-hidden="true">{note.glyph} </span>}{note.text}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 58px 0 52px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.16fr 0.84fr;
    gap: 38px;
    align-items: center;
  }

  .hero__title {
    max-width: 760px;
    font-size: clamp(56px, 7vw, 100px);
    font-weight: 900;
    line-height: 0.84;
    letter-spacing: -0.085em;
    text-transform: uppercase;
  }

  .hero__name {
    display: block;
    margin-bottom: 0.45em;
    font-size: clamp(26px, 3.4vw, 42px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .hero__intro {
    max-width: 570px;
    margin-top: 25px;
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  /* ----- Poster card ----- */

  .hero__poster-wrap {
    position: relative;
    padding: 18px 18px 40px 0;
  }

  .hero__poster {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 460px;
    overflow: hidden;
    border: var(--border);
    background: var(--blue);
    box-shadow: var(--shadow-lg);
    /* `rotate` (not transform) so the bouncy hover transform adds to the tilt */
    rotate: 2deg;
  }

  /* Bouncy photo card: straightens past level on hover, keeps its big shadow */
  .hero__poster.bouncy {
    --tilt: -3deg;
  }

  :root .hero__poster.bouncy:hover {
    box-shadow: 18px 18px 0 var(--ink);
  }

  .hero__poster-media :global(img) {
    transition: scale 0.6s cubic-bezier(0.34, 1.8, 0.64, 1);
  }

  .hero__poster:hover .hero__poster-media :global(img) {
    scale: 1.06;
  }

  .hero__poster-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 17px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 900;
  }

  .hero__poster-media {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  .hero__poster-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Photo is a tall portrait: aim below centre so the person, not the building, fills the frame */
    object-position: 50% 58%;
  }

  .hero__poster-bottom {
    padding: 12px 16px 14px;
    border-top: var(--border);
    background: var(--blue);
    font-size: 16px;
    font-weight: 900;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .hero__sticker {
    position: absolute;
    right: -5px;
    top: -8px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 105px;
    height: 105px;
    padding: 14px;
    border: var(--border);
    border-radius: 50%;
    background: var(--acid);
    box-shadow: var(--shadow-btn-alt);
    text-align: center;
    font-size: 14px;
    font-weight: 900;
    line-height: 1.05;
    text-transform: uppercase;
    transform: rotate(13deg);
    animation: hero-wiggle 4s ease-in-out infinite;
  }

  @keyframes hero-wiggle {
    0%,
    100% {
      transform: rotate(13deg);
    }

    50% {
      transform: rotate(5deg) scale(1.04);
    }
  }

  .hero__note {
    position: absolute;
    left: -21px;
    bottom: 0;
    z-index: 3;
    padding: 9px 12px;
    border: var(--border-thin);
    background: var(--white);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    transform: rotate(-7deg);
  }

  @media (max-width: 800px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__poster-wrap {
      max-width: 470px;
      width: 92%;
      margin: 0 auto;
    }
  }

  @media (max-width: 580px) {
    .hero {
      padding: 44px 0 44px;
    }

    .hero__title {
      font-size: 54px;
    }

    .hero__poster {
      height: 400px;
    }

    /* Keep the rotated note inside the 375px viewport */
    .hero__note {
      left: -6px;
    }
  }
</style>
